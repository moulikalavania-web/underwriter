  "testSuites": [
    {
      "id": "TS-1",
      "name": "Regression",
      "cases": [
        {
          "name": "Texas needs UM/UIM unless rejected",
          "input": {
            "state": "TX",
            "coverages": [
              "BI",
              "PD"
            ]
          },
          "expected": {
            "required": [
              "BI",
              "PD",
              "UMUIM"
            ],
            "missingRequired": [
              "UMUIM"
            ]
          }
        },
        {
          "name": "A signed rejection satisfies it",
          "input": {
            "state": "TX",
            "coverages": [
              "BI",
              "PD"
            ],
            "rejections": {
              "UMUIM": true
            }
          },
          "expected": {
            "missingRequired": [],
            "rejected": [
              "UMUIM"
            ]
          }
        },
        {
          "name": "Ohio needs it and cannot be rejected",
          "input": {
            "state": "OH",
            "coverages": [
              "BI",
              "PD"
            ],
            "rejections": {
              "UMUIM": true
            }
          },
          "expected": {
            "missingRequired": [
              "UMUIM"
            ]
          }
        },
        {
          "name": "Hired auto is not sold in California",
          "input": {
            "state": "CA",
            "coverages": [
              "BI",
              "PD",
              "HIRED"
            ]
          },
          "expected": {
            "notAvailable": [
              "HIRED"
            ],
            "issuesContain": [
              "not available"
            ]
          }
        },
        {
          "name": "Not offered in New York",
          "input": {
            "state": "NY",
            "coverages": [
              "BI"
            ]
          },
          "expected": {
            "offered": false
          }
        },
        {
          "name": "Texas UM/UIM default limit",
          "input": {
            "state": "TX",
            "coverages": [
              "BI",
              "PD",
              "UMUIM"
            ]
          },
          "expected": {
            "defaults": {
              "UMUIM": 300000
            },
            "optionAmounts": {
              "UMUIM": [
                300000,
                500000
              ]
            }
          }
        }
      ]
    }
  ]
